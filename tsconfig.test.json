{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true
  },
  "include": [
    "vitest.config.ts",
    "tools/**/*.spec.ts",
    "packages/**/*.spec.ts",
    "packages/**/*.spec.tsx",
    "packages/**/tests/**/*.ts",
    "packages/**/tests/**/*.tsx",
    "packages/**/tsdown.config.ts"
  ]
}
