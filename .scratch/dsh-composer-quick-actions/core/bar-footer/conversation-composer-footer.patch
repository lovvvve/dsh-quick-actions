+describe('resident composer footer', () => {
+  it('places actions in their own row after the unchanged dock and context meter', () => {
+    const { view, slotCalls } = bench({
+      footer: <button>Session statistics</button>,
+      composerFooter: <button>Quick action</button>,
+      contextPressure: { pressureTokens: 32_000, contextWindow: 128_000 },
+    })
+    const card = view.container.querySelector('[data-composer-card]')!
+    const dock = view.getByRole('button', { name: 'Session statistics' }).parentElement!
+    const action = view.getByRole('button', { name: 'Quick action' })
+    const footer = action.closest('[data-slot]')!.parentElement!
+    expect(dock.contains(view.getByRole('button', { name: '上下文已用 25%' }))).toBe(true)
+    expect(card.nextElementSibling).toBe(dock)
+    expect(dock.nextElementSibling).toBe(footer)
+    expect(footer.parentElement).toBe(card.parentElement)
+    expect(dock.contains(action)).toBe(false)
+    expect(slotCalls.find(call => call.key === 'conversation.composer.footer')?.owner).toEqual({})
+  })
+
+  it.each<BenchOptions>([
+    { variant: 'hero' }, { noSession: true }, { noInput: true },
+  ])('does not dispatch the footer outside the resident composer: %j', (options) => {
+    const { view, slotCalls } = bench({ ...options, composerFooter: <button>Quick action</button> })
+    expect(view.queryByRole('button', { name: 'Quick action' })).toBeNull()
+    expect(slotCalls.some(call => call.key === 'conversation.composer.footer')).toBe(false)
+  })
+
