@@ -0,0 +1,107 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import type { Context } from '@deepseek-ai/cordis'
+import { $getRoot, $isTextNode, $setSelection, UNDO_COMMAND } from 'lexical'
+import { SessionInputShell } from '../src/client/input/facade.ts'
+
+const shells: SessionInputShell[] = []
+
+function createShell(): SessionInputShell {
+  const shell = new SessionInputShell({
+    actx: {} as Context,
+    defaultSink: vi.fn(),
+    commandImages: {
+      serialize: () => Promise.resolve([]),
+      release: () => {},
+      unsupportedNotice: token => `${token.trim()} images-unsupported`,
+    },
+  })
+  shells.push(shell)
+  return shell
+}
+
+function selectText(shell: SessionInputShell, start: number, end: number): void {
+  shell.editor.update(() => {
+    const text = $getRoot().getAllTextNodes()[0]
+    if (!$isTextNode(text)) throw new Error('expected one text node')
+    text.select(start, end)
+  }, { discrete: true })
+}
+
+afterEach(() => {
+  for (const shell of shells.splice(0)) shell.dispose()
+})
+
+describe('public input actions', () => {
+  it('replaces the current editor selection', () => {
+    const shell = createShell()
+    shell.setDraft('alpha beta')
+    selectText(shell, 6, 10)
+
+    expect(shell.actions.insertText('replacement')).toBeUndefined()
+
+    expect(shell.snapshot.draft).toBe('alpha replacement')
+  })
+
+  it('inserts at the document end when no editor selection exists', () => {
+    const shell = createShell()
+    shell.setDraft('alpha')
+    shell.editor.update(() => { $setSelection(null) }, { discrete: true })
+
+    shell.actions.insertText(' beta')
+
+    expect(shell.snapshot.draft).toBe('alpha beta')
+  })
+
+  it('strips forged reference placeholders from inserted text', () => {
+    const shell = createShell()
+
+    shell.actions.insertText('\uE100visible\uFFFC')
+
+    expect(shell.snapshot.draft).toBe('visible')
+  })
+
+  it('publishes no edit when inserted text contains only reference placeholders', () => {
+    const shell = createShell()
+    const before = shell.state.getSnapshot()
+
+    shell.actions.insertText('\uFFFC')
+
+    expect(shell.state.getSnapshot()).toBe(before)
+  })
+
+  it('keeps one public insertion as its own undo boundary', () => {
+    const shell = createShell()
+    shell.setDraft('alpha')
+    shell.actions.insertText(' beta')
+
+    shell.editor.dispatchCommand(UNDO_COMMAND, undefined)
+    shell.editor.update(() => {}, { discrete: true })
+
+    expect(shell.snapshot.draft).toBe('alpha')
+  })
+
+  it('preserves an existing reference chip outside the insertion', () => {
+    const shell = createShell()
+    const mention = '@[Research](dsh-session:InNvdXJjZSI)'
+    shell.setDraft('@res')
+    expect(shell.insertReference({
+      source: 'reference',
+      ref: mention,
+      label: 'Research',
+      clipboardText: mention,
+    }, {
+      start: 0,
+      end: 4,
+      draftRev: shell.snapshot.draftRev,
+    })).toBe(true)
+
+    shell.actions.insertText('tail')
+
